# Copy to .env at the repository root and set the paths for your host (the file is ignored by git).
# DATA_DIR holds dataset.json, raw/images/<scan>.nii.gz and raw/segmentations/<scan>.nii.gz.
DATA_DIR=
# TotalSegmentator lobe masks, one <scan>.nii.gz per scan with labels 1-5 (produced by the training
# repository's Phase 5 stage 1a). Optional: without them the lung-normalised columns are empty.
LOBES_DIR=
# Where the tables are written (default: <repo>/tables).
TABLES_DIR=
